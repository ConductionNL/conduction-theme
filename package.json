{
  "name": "@conduction/theme",
  "version": "2.1.0",
  "description": "Conduction's design tokens theme",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/Conduction/conduction-theme.git"
  },
  "scripts": {
    "postinstall": "npm run build",
    "build": "npm-run-all build:**",
    "// conduction": "== Conduction baseline theme, always built first ==",
    "build:conduction": "cd ./conduction-design-tokens && npm run build",
    "// municipalities": "== Municipalities (gemeenten), alphabetical ==",
    "build:almere": "cd ./municipalities/almere-design-tokens && npm run build",
    "build:baarn": "cd ./municipalities/baarn-design-tokens && npm run build",
    "build:beek": "cd ./municipalities/beek-design-tokens && npm run build",
    "build:buren": "cd ./municipalities/buren-design-tokens && npm run build",
    "build:dinkelland": "cd ./municipalities/dinkelland-design-tokens && npm run build",
    "build:ede": "cd ./municipalities/ede-design-tokens && npm run build",
    "build:epe": "cd ./municipalities/epe-design-tokens && npm run build",
    "build:gooise-meren": "cd ./municipalities/gooise-meren-design-tokens && npm run build",
    "build:gouda": "cd ./municipalities/gouda-design-tokens && npm run build",
    "build:helmond": "cd ./municipalities/helmond-design-tokens && npm run build",
    "build:hof-van-twente": "cd ./municipalities/hof-van-twente-design-tokens && npm run build",
    "build:lansingerland": "cd ./municipalities/lansingerland-design-tokens && npm run build",
    "build:leiden": "cd ./municipalities/leiden-design-tokens && npm run build",
    "build:midden-delfland": "cd ./municipalities/midden-delfland-design-tokens && npm run build",
    "build:moerdijk": "cd ./municipalities/moerdijk-design-tokens && npm run build",
    "build:noordwijk": "cd ./municipalities/noordwijk-design-tokens && npm run build",
    "build:oude-ijsselstreek": "cd ./municipalities/oude-ijsselstreek-design-tokens && npm run build",
    "build:roosendaal": "cd ./municipalities/roosendaal-design-tokens && npm run build",
    "build:rotterdam": "cd ./municipalities/rotterdam-design-tokens && npm run build-all",
    "build:soest": "cd ./municipalities/soest-design-tokens && npm run build",
    "build:stichtse-vecht": "cd ./municipalities/stichtse-vecht-design-tokens && npm run build",
    "build:tubbergen": "cd ./municipalities/tubbergen-design-tokens && npm run build",
    "build:vaals": "cd ./municipalities/vaals-design-tokens && npm run build",
    "build:voorschoten": "cd ./municipalities/voorschoten-design-tokens && npm run build",
    "build:wassenaar": "cd ./municipalities/wassenaar-design-tokens && npm run build",
    "build:zutphen": "cd ./municipalities/zutphen-design-tokens && npm run build",
    "// partnerships": "== Partnerships (samenwerkingsverbanden), alphabetical ==",
    "build:noaberkracht": "cd ./partnerships/noaberkracht-design-tokens && npm run build",
    "// water-authorities": "== Water authorities (waterschappen), alphabetical ==",
    "build:noorderzijlvest": "cd ./water-authorities/noorderzijlvest-design-tokens && npm run build",
    "// other": "== Other themes (products, companies, programs, demos), alphabetical ==",
    "build:bct": "cd ./other/bct-design-tokens && npm run build",
    "build:commonground": "cd ./other/commonground-design-tokens && npm run build",
    "build:dimpact": "cd ./other/dimpact-design-tokens && npm run build",
    "build:migrato": "cd ./other/migrato-design-tokens && npm run build",
    "build:open-webconcept": "cd ./other/open-webconcept-design-tokens && npm run build",
    "build:opencatalogi": "cd ./other/opencatalogi-design-tokens && npm run build",
    "build:openwoo": "cd ./other/openwoo-design-tokens && npm run build",
    "build:sloterburg": "cd ./other/sloterburg-design-tokens && npm run build",
    "build:xxllnc": "cd ./other/xxllnc-design-tokens && npm run build",
    "build:zuiddrecht": "cd ./other/zuiddrecht-design-tokens && npm run build"
  },
  "dependencies": {
    "@nl-design-system-unstable/rotterdam-design-tokens": "^1.0.0-alpha.100",
    "npm-run-all2": "^8.0.4",
    "sass": "^1.70.0",
    "style-dictionary": "^3.9.2"
  },
  "overrides": {
    "style-dictionary": {
      "glob": "^11.0.0"
    }
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://codeberg.org/Conduction/conduction-theme/issues"
  },
  "homepage": "https://codeberg.org/Conduction/conduction-theme#readme",
  "devDependencies": {
    "rimraf": "^6.1.3"
  }
}
